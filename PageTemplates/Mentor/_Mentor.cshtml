@using Kentico.PageBuilder.Web.Mvc
@using Kentico.Content.Web.Mvc
@using Kentico.Content.Web.Mvc.PageBuilder
@using Kentico.Web.Mvc
@using LearnHub
@using CMS.ContentEngine
@using CMS.Websites
@inject IWebPageDataContextRetriever webPageDataContextRetriever
@inject IContentRetriever contentRetriever

@model TemplateViewModel<PageTemplates.Mentor.MentorPageTemplateProperties>

@{
    var pageDataContext = webPageDataContextRetriever.Retrieve();
    var webPageItemGuid = pageDataContext.WebPage.WebPageItemGUID;
    
    // Retrieve the full Mentor data with linked items
    var mentorResult = await contentRetriever.RetrievePages<Mentor>(
        new RetrievePagesParameters
        {
            LinkedItemsMaxLevel = 1  // Load linked Assets for MentorThumbnail
        },
        query => query
            .Where(w => w.WhereEquals(nameof(WebPageFields.WebPageItemGUID), webPageItemGuid))
            .TopN(1),
        new RetrievalCacheSettings($"Mentor_{webPageItemGuid}", TimeSpan.FromMinutes(5)),
        Context.RequestAborted
    );
    
    var mentor = mentorResult.FirstOrDefault();
    var thumbnail = mentor?.MentorThumbnail?.FirstOrDefault();
    var thumbnailUrl = thumbnail?.Photo?.Url ?? "/images/placeholder-mentor.jpg";
    
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = mentor?.MentorName ?? "Mentor";
}

<!-- Mentor Detail Section -->
<section class="py-lg-10 py-8 bg-light">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-xl-8">
                @if (mentor != null)
                {
                    <!-- Mentor Profile Card -->
                    <article class="bg-white rounded-3 shadow-sm overflow-hidden">
                        <div class="p-lg-8 p-6">
                            <!-- Mentor Header -->
                            <div class="text-center mb-6">
                                <div class="position-relative d-inline-block mb-4">
                                    @if (thumbnail != null)
                                    {
                                        <img src="@thumbnailUrl" 
                                             alt="@mentor.MentorName" 
                                             class="rounded-circle avatar avatar-xxxl border border-4 border-warning" />
                                    }
                                    
                                    @if (mentor.MentorStars > 0)
                                    {
                                        <div class="position-absolute bottom-0 end-0 mb-2 me-2">
                                            <span class="badge bg-warning text-sm px-3 py-2">
                                                <span>@mentor.MentorStars.ToString("0.0")</span>
                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"
                                                     class="icon icon-tabler icons-tabler-filled icon-tabler-star text-white">
                                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                                    <path d="M12 17.75l-6.172 3.245l1.179 -6.873l-5 -4.867l6.9 -1l3.093 -6.26l3.093 6.26l6.9 1l-5 4.867l1.179 6.873z" />
                                                </svg>
                                            </span>
                                        </div>
                                    }
                                </div>
                                
                                <h1 class="mb-2 fw-bold">@mentor.MentorName</h1>
                                
                                @if (!string.IsNullOrEmpty(mentor.MentorTitle))
                                {
                                    <p class="text-muted lead mb-4">@mentor.MentorTitle</p>
                                }
                                
                                <!-- Social Links -->
                                <div class="d-flex justify-content-center gap-3 mb-5">
                                    @if (!string.IsNullOrEmpty(mentor.FirstButtonLink))
                                    {
                                        <a href="@mentor.FirstButtonLink" class="btn rounded-circle btn-light btn-icon">
                                            @if (!string.IsNullOrEmpty(mentor.FirstLinkIcon))
                                            {
                                                @Html.Raw(mentor.FirstLinkIcon)
                                            }
                                            else
                                            {
                                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                                                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                                     class="icon icon-tabler icons-tabler-outline icon-tabler-brand-x">
                                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                                    <path d="M4 4l11.733 16h4.267l-11.733 -16z" />
                                                    <path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772" />
                                                </svg>
                                            }
                                        </a>
                                    }
                                    
                                    @if (!string.IsNullOrEmpty(mentor.SecondButtonLink))
                                    {
                                        <a href="@mentor.SecondButtonLink" class="btn rounded-circle btn-light btn-icon">
                                            @if (!string.IsNullOrEmpty(mentor.SecondLinkIcon))
                                            {
                                                @Html.Raw(mentor.SecondLinkIcon)
                                            }
                                            else
                                            {
                                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                                                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                                     class="icon icon-tabler icons-tabler-outline icon-tabler-brand-linkedin">
                                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                                    <path d="M8 11v5" />
                                                    <path d="M8 8v.01" />
                                                    <path d="M12 16v-5" />
                                                    <path d="M16 16v-3a2 2 0 1 0 -4 0" />
                                                    <path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z" />
                                                </svg>
                                            }
                                        </a>
                                    }
                                    
                                    @if (!string.IsNullOrEmpty(mentor.ThirdButtonLink))
                                    {
                                        <a href="@mentor.ThirdButtonLink" class="btn rounded-circle btn-light btn-icon">
                                            @if (!string.IsNullOrEmpty(mentor.ThirdLinkIcon))
                                            {
                                                @Html.Raw(mentor.ThirdLinkIcon)
                                            }
                                            else
                                            {
                                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                                                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                                     class="icon icon-tabler icons-tabler-brand-github">
                                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                                    <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12 12 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" />
                                                </svg>
                                            }
                                        </a>
                                    }
                                </div>
                            </div>
                            
                            <!-- Stats Row -->
                            <div class="row g-4 mb-5 border-top border-bottom py-4">
                                @if (mentor.MentorFollowers > 0)
                                {
                                    <div class="col-md-6 text-center">
                                        <div class="d-flex align-items-center justify-content-center gap-2">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                                                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                                 class="icon icon-tabler icons-tabler-users text-primary">
                                                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                                <circle cx="9" cy="7" r="4" />
                                                <path d="M3 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" />
                                                <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                                                <path d="M21 21v-2a4 4 0 0 0 -3 -3.85" />
                                            </svg>
                                            <div>
                                                <h3 class="mb-0 fw-bold text-primary">@mentor.MentorFollowers.ToString("N0")</h3>
                                                <small class="text-muted">Students</small>
                                            </div>
                                        </div>
                                    </div>
                                }
                                
                                @if (mentor.MentorCourses > 0)
                                {
                                    <div class="col-md-6 text-center">
                                        <div class="d-flex align-items-center justify-content-center gap-2">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                                                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                                 class="icon icon-tabler icons-tabler-outline icon-tabler-book text-primary">
                                                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                                <path d="M3 19a9 9 0 0 1 9 0a9 9 0 0 1 9 0" />
                                                <path d="M3 6a9 9 0 0 1 9 0a9 9 0 0 1 9 0" />
                                                <path d="M3 6l0 13" />
                                                <path d="M12 6l0 13" />
                                                <path d="M21 6l0 13" />
                                            </svg>
                                            <div>
                                                <h3 class="mb-0 fw-bold text-primary">@mentor.MentorCourses</h3>
                                                <small class="text-muted">Courses</small>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                            
                            <!-- Mentor Description -->
                            @if (!string.IsNullOrEmpty(mentor.MentorDescription))
                            {
                                <div class="mb-4 px-4">
                                    <h4 class="mb-3">About</h4>
                                    <p class="lead">@mentor.MentorDescription</p>
                                </div>
                            }
                        </div>
                    </article>
                    
                    <!-- Editable Area for Additional Content -->
                    <div class="mt-5">
                        <editable-area area-identifier="additional-content" />
                    </div>
                }
                else
                {
                    <div class="bg-white p-5 rounded-3 text-center">
                        <p class="text-muted">Mentor information not available.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
