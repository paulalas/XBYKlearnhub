@using Kentico.PageBuilder.Web.Mvc
@using Kentico.Content.Web.Mvc
@using Kentico.Content.Web.Mvc.PageBuilder
@using Kentico.Web.Mvc
@using CMS.ContentEngine
@using CMS.Websites

@inject IContentRetriever contentRetriever
@inject IWebPageDataContextRetriever webPageDataContextRetriever

@model TemplateViewModel<PageTemplates.TestimonialsList.TestimonialsListPageTemplateProperties>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    // Get the current page GUID
    var webPageItemGuid = webPageDataContextRetriever.Retrieve().WebPage.WebPageItemGUID;
    
    // Retrieve the TestimonialsList page with all properties
    var testimonialsListPage = (await contentRetriever.RetrievePages<LearnHub.TestimonialsList>(
        new RetrievePagesParameters(),
        query => query
            .Where(w => w.WhereEquals(nameof(WebPageFields.WebPageItemGUID), webPageItemGuid))
            .TopN(1),
        new RetrievalCacheSettings($"TestimonialsList_{webPageItemGuid}", TimeSpan.FromMinutes(5)),
        Context.RequestAborted))
        .FirstOrDefault();
    
    ViewData["Title"] = testimonialsListPage?.Title ?? "Testimonials";
}

<section class="py-lg-13 py-8 bg-light bg-opacity-50" id="testimonials">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="text-center mb-10">
                    @if (!string.IsNullOrEmpty(testimonialsListPage?.Name))
                    {
                        <span class="text-primary text-uppercase small fw-semibold" style="letter-spacing: .125rem;">@testimonialsListPage.Name</span>
                    }
                    
                    @if (!string.IsNullOrEmpty(testimonialsListPage?.Title))
                    {
                        <h2 class="fw-bold mt-4 mb-4">@Html.Raw(testimonialsListPage.Title)</h2>
                    }
                    
                    @if (!string.IsNullOrEmpty(testimonialsListPage?.Description))
                    {
                        <p>@testimonialsListPage.Description</p>
                    }
                </div>
            </div>
        </div>
        
        <editable-area area-identifier="main" />
    </div>
</section>
