@using Kentico.PageBuilder.Web.Mvc
@using Kentico.Content.Web.Mvc
@using Kentico.Content.Web.Mvc.PageBuilder
@using Kentico.Web.Mvc
@using LearnHub
@using CMS.ContentEngine
@using CMS.Websites
@inject IWebPageDataContextRetriever webPageDataContextRetriever
@inject IContentRetriever contentRetriever

@model TemplateViewModel<PageTemplates.Course.CoursePageTemplateProperties>

@{
    var pageDataContext = webPageDataContextRetriever.Retrieve();
    var webPageItemGuid = pageDataContext.WebPage.WebPageItemGUID;
    
    // Retrieve the full Course data with linked items
    var courseResult = await contentRetriever.RetrievePages<Course>(
        new RetrievePagesParameters
        {
            LinkedItemsMaxLevel = 1  // Load linked Assets for CourseThumbnail
        },
        query => query
            .Where(w => w.WhereEquals(nameof(WebPageFields.WebPageItemGUID), webPageItemGuid))
            .TopN(1),
        new RetrievalCacheSettings($"Course_{webPageItemGuid}", TimeSpan.FromMinutes(5)),
        Context.RequestAborted
    );
    
    var course = courseResult.FirstOrDefault();
    var thumbnail = course?.CourseThumbnail?.FirstOrDefault();
    var thumbnailUrl = thumbnail?.Photo?.Url ?? "/images/placeholder-course.jpg";
    
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = course?.CourseTitle ?? "Course";
}

<!-- Course Detail Section -->
<section class="py-lg-10 py-8 bg-light">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-xl-8">
                <!-- Course Article -->
                <article class="bg-white rounded-3 shadow-sm overflow-hidden">
                    
                    @if (course != null)
                    {
                        <!-- Course Thumbnail -->
                        @if (thumbnail != null)
                        {
                            <div class="course-thumbnail">
                                <img src="@thumbnailUrl" 
                                     alt="@course.CourseTitle" 
                                     class="w-100"
                                     style="max-height: 400px; object-fit: cover;" />
                            </div>
                        }
                        
                        <!-- Course Content -->
                        <div class="p-lg-6 p-4">
                            
                            <!-- Course Title -->
                            <h1 class="mb-3 fw-bold">@course.CourseTitle</h1>
                            
                            <!-- Course Meta Information -->
                            <div class="d-flex flex-wrap gap-3 mb-4 text-muted">
                                @if (!string.IsNullOrEmpty(course.CourseTeacherName))
                                {
                                    <small class="d-flex align-items-center">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person me-1" viewBox="0 0 16 16">
                                            <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z"/>
                                        </svg>
                                        <span>Instructor: <strong>@course.CourseTeacherName</strong></span>
                                    </small>
                                }
                                
                                @if (!string.IsNullOrEmpty(course.CourseDuration))
                                {
                                    <small class="d-flex align-items-center">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-clock me-1" viewBox="0 0 16 16">
                                            <path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71z"/>
                                            <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0"/>
                                        </svg>
                                        <span>@course.CourseDuration</span>
                                    </small>
                                }
                                
                                @if (course.CourseFollowers > 0)
                                {
                                    <small class="d-flex align-items-center">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-people me-1" viewBox="0 0 16 16">
                                            <path d="M15 14s1 0 1-1-1-4-5-4-5 3-5 4 1 1 1 1zm-7.978-1L7 12.996c.001-.264.167-1.03.76-1.72C8.312 10.629 9.282 10 11 10c1.717 0 2.687.63 3.24 1.276.593.69.758 1.457.76 1.72l-.008.002-.014.002zM11 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4m3-2a3 3 0 1 1-6 0 3 3 0 0 1 6 0M6.936 9.28a6 6 0 0 0-1.23-.247A7 7 0 0 0 5 9c-4 0-5 3-5 4q0 1 1 1h4.216A2.24 2.24 0 0 1 5 13c0-1.01.377-2.042 1.09-2.904.243-.294.526-.569.846-.816M4.92 10A5.5 5.5 0 0 0 4 13H1c0-.26.164-1.03.76-1.724.545-.636 1.492-1.256 3.16-1.275ZM1.5 5.5a3 3 0 1 1 6 0 3 3 0 0 1-6 0m3-2a2 2 0 1 0 0 4 2 2 0 0 0 0-4"/>
                                        </svg>
                                        <span>@course.CourseFollowers.ToString("N0") students</span>
                                    </small>
                                }
                                
                                @if (course.CourseStars > 0)
                                {
                                    <small class="d-flex align-items-center text-warning">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-star-fill me-1" viewBox="0 0 16 16">
                                            <path d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z"/>
                                        </svg>
                                        <span>@course.CourseStars.ToString("0.0") rating</span>
                                    </small>
                                }
                            </div>
                            
                            <!-- Course Description -->
                            @if (!string.IsNullOrEmpty(course.CourseDescription))
                            {
                                <div class="mb-5">
                                    <p class="lead text-dark">@course.CourseDescription</p>
                                </div>
                            }
                            
                            <!-- Price and Enrollment Section -->
                            <div class="border-top pt-4 mt-4">
                                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                                    <div>
                                        <p class="text-muted mb-1 small">Course Price</p>
                                        <h3 class="text-primary mb-0 fw-bold">
                                            @if (course.CoursePrice > 0)
                                            {
                                                <span>$@course.CoursePrice.ToString("N2")</span>
                                            }
                                            else
                                            {
                                                <span class="text-success">Free</span>
                                            }
                                        </h3>
                                    </div>
                                    
                                    @if (!string.IsNullOrEmpty(course.ButtonName))
                                    {
                                        <div>
                                            <a href="#" class="btn btn-primary btn-lg px-5">
                                                @course.ButtonName
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="p-5 text-center">
                            <p class="text-muted">Course information not available.</p>
                        </div>
                    }
                    
                </article>
                
                <!-- Editable Area for Additional Content -->
                <div class="mt-5">
                    <editable-area area-identifier="additional-content" />
                </div>
            </div>
        </div>
    </div>
</section>
